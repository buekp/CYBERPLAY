import React, { useState } from "react";
import { Check, Clock3, Coins, Shield, ShoppingBag, Sparkles, X } from "lucide-react";

const shopItems = [
  { id:"avatar-neon", name:"Neon Runner", category:"Avatars", icon:"🧑‍🚀", price:80, duration:"Permanent", rarity:"Rare", desc:"A street racer from the neon district." },
  { id:"avatar-ghost", name:"Ghost Protocol", category:"Avatars", icon:"👻", price:120, duration:"Permanent", rarity:"Epic", desc:"Disappear into the digital night." },
  { id:"avatar-cybercat", name:"Cyber Cat", category:"Avatars", icon:"🐱", price:60, duration:"7 days", rarity:"Common", desc:"A playful companion with a cybernetic glow." },
  { id:"avatar-android", name:"Chrome Android",category:"Avatars", icon:"🤖", price:150, duration:"Permanent", rarity:"Epic", desc:"Precision-built for the future." },
  { id:"frame-neon", name:"Neon Circuit", category:"Frames", icon:"▣", price:50, duration:"Permanent", rarity:"Common", desc:"A glowing electric border for your avatar." },
  { id:"frame-void", name:"Void Reactor", category:"Frames", icon:"◈", price:110, duration:"Permanent", rarity:"Rare", desc:"A reactor-powered avatar frame." },
  { id:"frame-royal", name:"Quantum Crown", category:"Frames", icon:"♛", price:180, duration:"Permanent", rarity:"Legendary", desc:"A prestigious frame from the arcade." },
  { id:"theme-toxic", name:"Toxic Green", category:"Themes", icon:"🟢", price:70, duration:"Permanent", rarity:"Rare", desc:"A radioactive green interface palette." },
  { id:"theme-sunset", name:"Afterglow", category:"Themes", icon:"🌆", price:90, duration:"7 days", rarity:"Rare", desc:"Warm magenta and violet night colors." },
  { id:"theme-arctic", name:"Arctic Pulse", category:"Themes", icon:"❄️", price:100, duration:"Permanent", rarity:"Epic", desc:"A cool blue holographic interface." }
];

export default function ShopPage({ coins, owned, equipped, onBuy, onEquip }) {
  const [category, setCategory] = useState("All Items");
  const [confirmItem, setConfirmItem] = useState(null);
  const filteredItems = category === "All Items" ? shopItems : shopItems.filter(item => item.category === category);

  return <section className="content">
    <div className="eyebrow"><span/> PERSONALIZE YOUR IDENTITY</div>
    <div className="hero-row">
      <div><h1>CYBER <em>SHOP.</em></h1>
      <p className="subtitle">Build your look. Own your style.</p></div>
      <div className="shop-balance"><Coins/><div>
        <small>YOUR BALANCE</small><b>{coins.toLocaleString()} CC</b>
        </div>
    </div>
  </div>
    <div className="shop-intro"><div className="intro-icon"><Sparkles/></div>
    <div><b>LOOK GOOD IN THE GRID.</b><p>Collect neon avatars, frames, and themes for your arcade collection.</p>
    </div>
  </div>
    <div className="shop-toolbar">
      <div className="category-tabs">{["All Items","Avatars","Frames","Themes"].map(itemCategory=><button key={itemCategory} className={category===itemCategory?"chosen":""} onClick={()=>setCategory(itemCategory)}>{itemCategory}</button>)}</div>
      <span className="muted">{filteredItems.length} ITEMS</span>
  </div>
    <div className="shop-grid">{filteredItems.map(item=>{
      const isOwned=owned.includes(item.id);
      const slot=item.category==="Avatars"?"avatar":item.category==="Frames"?"frame":"theme";
      const isEquipped=equipped[slot]===item.id;
      return <article className="shop-card" key={item.id}>
        <div className={`item-art ${item.category==="Frames"?"frame-art":item.category==="Themes"?"theme-art":""}`}>
          <span>{item.icon}</span>
          <div className="rarity">{item.rarity}</div>
          {isEquipped&&<div className="equipped-tag"><Check size={12}/> EQUIPPED</div>}
        </div>
        <div className="item-info"><div className="item-category">{item.category.toUpperCase()}</div>
        <h3>{item.name}</h3>
        <p>{item.desc}</p>
        <div className="item-meta"><span><Clock3 size={13}/>{item.duration}</span>
        <span className="price"><Coins size={14}/>{item.price} CC</span>
        </div>
        {isEquipped?<button className="item-btn equipped-btn" disabled><Check size={15}/> EQUIPPED</button>:isOwned?
        <button className="item-btn equip-btn" onClick={()=>onEquip(item)}>EQUIP ITEM</button>:
        <button className="item-btn buy-btn" onClick={()=>setConfirmItem(item)}>PURCHASE ITEM</button>}
        </div>
      </article>;
    })}</div>
    <p className="shop-footnote"><Shield size={14}/> Cosmetic purchases are linked to your player inventory. Permanent items remain yours; timed items expire after their listed duration when expiry handling is connected.</p>

    {confirmItem && <div className="modal-backdrop" onClick={()=>setConfirmItem(null)}><div className="confirm-modal" onClick={event=>event.stopPropagation()}>
      <button className="modal-close" onClick={()=>setConfirmItem(null)}><X/></button>
      <div className="modal-symbol">{confirmItem.icon}</div><div className="eyebrow">PURCHASE CONFIRMATION</div>
      <h2>{confirmItem.name}</h2>
      <p>{confirmItem.desc}</p>
      <div className="confirm-line"><span>Item type</span><b>{confirmItem.category}</b></div>
      <div className="confirm-line"><span>Duration</span><b>{confirmItem.duration}</b></div>
      <div className="confirm-line"><span>Price</span><b className="price"><Coins size={15}/>{confirmItem.price} CC</b></div>
      <div className="confirm-line"><span>Balance after purchase</span><b>{(coins-confirmItem.price).toLocaleString()} CC</b></div>
      <button className="spin-btn full" disabled={coins<confirmItem.price} onClick={()=>{onBuy(confirmItem);setConfirmItem(null);}}>{coins<confirmItem.price?"NOT ENOUGH COINS":"CONFIRM PURCHASE"}</button>
      <button className="cancel-btn" onClick={()=>setConfirmItem(null)}>CANCEL</button>
      </div>
    </div>}
  </section>;
}
